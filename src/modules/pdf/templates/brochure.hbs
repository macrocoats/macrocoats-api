<main class="brochure" style="--brochure-accent: {{brochureAccent}}; --brochure-accent-light: {{brochureAccentLight}}; --brochure-accent-sub: {{brochureAccentSub}};">
  <header class="brochure-top">
    <img src="{{brochureLogoDataUri}}" alt="{{brochureCompany.name}}">
    <div class="brochure-top__meta"><span>Product Brochure</span><i></i><b>{{productName}}</b></div>
  </header>

  <section class="brochure-hero">
    <img class="brochure-hero__photo" src="{{brochureHeroDataUri}}" alt="">
    <div class="brochure-hero__shade"></div>
    <div class="brochure-hero__copy">
      {{#if category}}<span class="brochure-eyebrow"><i></i>{{category}}</span>{{/if}}
      <h1>{{productName}}</h1>
      {{#if subtitle}}<p class="brochure-subtitle">{{subtitle}}</p>{{/if}}
      {{#if brochureDescription}}<p class="brochure-overview">{{brochureDescription}}</p>{{/if}}
    </div>
  </section>

  {{#if brochureBenefits.length}}
  <section class="brochure-benefits" style="grid-template-columns: repeat({{brochureBenefits.length}}, minmax(0, 1fr));">
    {{#each brochureBenefits}}
    <div><span class="brochure-benefits__label">{{label}}</span><span class="brochure-benefits__value{{#if isLong}} is-long{{/if}}">{{value}}</span>{{#if note}}<span class="brochure-benefits__note">{{note}}</span>{{/if}}</div>
    {{/each}}
  </section>
  {{/if}}

  <div class="brochure-body">
    {{#if brochureFeatures.length}}
    <section class="brochure-section">
      <h2><em>{{brochureNum.features}}</em><span>Product Features</span><i></i></h2>
      <div class="brochure-features" style="grid-template-columns: repeat({{brochureFeatures.length}}, minmax(0, 1fr));">
        {{#each brochureFeatures}}
        <div><b><i></i>{{head}}</b><span>{{body}}</span></div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if brochureSteps.length}}
    <section class="brochure-section">
      <h2><em>{{brochureNum.steps}}</em><span>Typical Process Sequence</span><i></i>{{#if brochureHasProductStep}}<small><u></u>{{productName}} stage</small>{{/if}}</h2>
      <ol class="brochure-steps" style="grid-template-columns: repeat({{brochureSteps.length}}, minmax(0, 1fr));">
        {{#each brochureSteps}}
        <li class="{{#if isProduct}}is-product{{/if}}">
          <div class="brochure-steps__head"><span class="brochure-steps__num">{{number}}</span>{{#if isProduct}}<span class="brochure-steps__tag">{{../productName}}</span>{{/if}}</div>
          <b>{{name}}</b>
          {{#if param}}<span class="brochure-steps__param">{{param}}</span>{{/if}}
          {{#if value}}<span class="brochure-steps__value">{{value}}</span>{{/if}}
        </li>
        {{/each}}
      </ol>
    </section>
    {{/if}}

    {{#if brochureSpecs.length}}
    <section class="brochure-section">
      <h2><em>{{brochureNum.specs}}</em><span>Technical Profile</span><i></i></h2>
      <div class="brochure-specs">
        {{#each brochureSpecs}}<div><span>{{property}}</span><span>{{displayValue}}</span></div>{{/each}}
      </div>
    </section>
    {{/if}}

    {{#if sections.safetyNote}}
    <section class="brochure-safety"><b><i>!</i>Safe Application</b><p>{{sections.safetyNote}} <span>Refer to the current SDS before handling or use.</span></p></section>
    {{/if}}
  </div>

  <footer class="brochure-footer">
    <div class="brochure-footer__row">
      <div class="brochure-footer__brand"><b>{{brochureCompany.legalName}}</b><span>Engineered Performance · Process Consistency · Surface Protection · Industrial Reliability</span></div>
      <div class="brochure-footer__contact"><span>{{brochureCompany.phone}}</span><span>{{brochureCompany.email}}</span><span>{{brochureCompany.website}}</span></div>
      <div class="brochure-footer__qr"><img src="{{brochureQrDataUri}}" alt="QR code for {{brochureCompany.website}}"><span>Scan to visit<br>our website</span></div>
    </div>
    <div class="brochure-footer__bar"></div>
  </footer>
</main>
