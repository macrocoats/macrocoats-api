<main class="brochure">
  <header class="brochure-hero">
    <div class="brochure-hero__copy">
      <span class="brochure-eyebrow">{{category}} · Technical guide</span>
      <h1>{{productName}}</h1>
      {{#if subtitle}}<p class="brochure-subtitle">{{subtitle}}</p>{{/if}}
      {{#if brochureDescription}}<p class="brochure-description">{{brochureDescription}}</p>{{/if}}
    </div>
    <div class="brochure-hero__visual" aria-hidden="true">
      <img class="brochure-hero__photo" src="{{brochureHeroDataUri}}" alt="">
      <div class="brochure-brand"><img src="{{brochureLogoDataUri}}" alt=""><span><b>MACRO COATS P LTD</b><small>Specialty surface treatment chemicals</small></span></div>
    </div>
  </header>

  <section class="brochure-ribbon">
    <span>Engineered performance</span><span>Process consistency</span><span>Surface protection</span><span>Industrial reliability</span>
  </section>

  <div class="brochure-grid">
    <div class="brochure-column">
      <section class="brochure-panel brochure-panel--dark">
        <h2>Product overview</h2>
        <ul class="brochure-checks">
          {{#each brochureFeatures}}<li><b>{{head}}</b><span>{{body}}</span></li>{{/each}}
        </ul>
      </section>

      {{#if hasBrochureSpecs}}
      <section class="brochure-panel">
        <h2>Technical profile</h2>
        <table class="brochure-table"><tbody>
          {{#each brochureSpecs}}<tr><th>{{property}}</th><td>{{displayValue}}</td></tr>{{/each}}
        </tbody></table>
      </section>
      {{/if}}

    </div>

    <div class="brochure-column">
      {{#if hasBrochureApplication}}
      <section class="brochure-panel">
        <h2>Typical process sequence</h2>
        <ol class="brochure-process">
          {{#each brochureApplication}}<li><span>{{step}}</span><div><b>{{name}}</b><small>{{param}}{{#if value}} · {{value}}{{/if}}</small></div></li>{{/each}}
        </ol>
      </section>
      {{/if}}

      <section class="brochure-panel">
        <h2>Key benefits</h2>
        <div class="brochure-benefits">
          {{#each brochureBenefits}}<div><span>✓</span><p><b>{{label}}</b>{{val}}</p></div>{{/each}}
          {{#unless brochureBenefits}}{{#each brochureFeatures}}<div><span>✓</span><p><b>{{head}}</b>{{body}}</p></div>{{/each}}{{/unless}}
        </div>
      </section>

      {{#if sections.safetyNote}}
      <section class="brochure-note"><b>Safe application</b><p>{{sections.safetyNote}}</p><span>Refer to the current SDS before handling or use.</span></section>
      {{/if}}
    </div>

    <section class="brochure-advantages">
      <h2><span></span>Advantages of {{productName}}<span></span></h2>
      <div class="brochure-advantages__grid">
        {{#each brochureHighlights}}
        <div><span class="brochure-advantages__icon">✓</span><b>{{this}}</b></div>
        {{/each}}
      </div>
    </section>
  </div>

  <footer class="brochure-footer">
    <div><b>Macro Coats P Ltd</b><span>{{_meta.docTitle}} · {{productName}}</span></div>
    <div><b>9444961815 · info@macrocoats.in</b><span>www.macrocoats.in</span></div>
    <div class="brochure-footer__qr"><img src="{{brochureQrDataUri}}" alt="QR code for macrocoats.in"><span><b>Scan to visit our website</b>www.macrocoats.in</span></div>
  </footer>
</main>
