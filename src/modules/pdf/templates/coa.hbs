<article class="coa-cert" style="--doc-accent: {{accentColor}}; --doc-accent-text: {{accentTextColor}}; --coa-print-zoom: {{coaPrintZoom}}">
  <img class="coa-cert__watermark" src="{{coaWatermarkDataUri}}" alt="">

  <header class="coa-cert__letterhead">
    <div class="coa-cert__brand">
      <img class="coa-cert__logo" src="{{coaLogoDataUri}}" alt="Macro Coats">
      <div>
        <div class="coa-cert__company">{{company}}</div>
        <div class="coa-cert__tagline">{{coaBrand.tagline}}</div>
        <div class="coa-cert__contact">{{coaBrand.certificateLocation}} · {{coaBrand.email}}</div>
      </div>
    </div>
    <div class="coa-cert__ref">
      <div class="coa-cert__doctype">Certificate of Analysis</div>
      <div class="coa-cert__certno">{{batchNumber}}</div>
      <div class="coa-cert__code">{{productCode}}{{#if revision}} · {{revision}}{{/if}}</div>
    </div>
  </header>
  <div class="coa-cert__rule"></div>

  <div class="coa-cert__identity">
    <div>
      <div class="coa-cert__product">{{productName}}</div>
      {{#if subtitle}}<div class="coa-cert__subtitle">{{subtitle}}</div>{{/if}}
    </div>
  </div>

  <dl class="coa-cert__info">
    <div class="coa-cert__info-cell"><dt>Batch number</dt><dd>{{batchNumber}}</dd></div>
    <div class="coa-cert__info-cell"><dt>Batch size</dt><dd>{{#if quantity}}{{quantity}}{{else}}—{{/if}}</dd></div>
    <div class="coa-cert__info-cell"><dt>Mfg date</dt><dd>{{#if manufacturingDate}}{{manufacturingDate}}{{else}}—{{/if}}</dd></div>
    <div class="coa-cert__info-cell"><dt>Expiry date</dt><dd>{{#if expiryDate}}{{expiryDate}}{{else}}—{{/if}}</dd></div>
    <div class="coa-cert__info-cell"><dt>Customer</dt><dd>{{#if customer.companyName}}{{customer.companyName}}{{else}}—{{/if}}</dd></div>
    <div class="coa-cert__info-cell"><dt>P.O. number</dt><dd>{{#if customer.poNumber}}{{customer.poNumber}}{{else}}—{{/if}}</dd></div>
    <div class="coa-cert__info-cell"><dt>Grade</dt><dd>{{#if grade}}{{grade}}{{else}}—{{/if}}</dd></div>
    <div class="coa-cert__info-cell"><dt>Appearance</dt><dd>{{#if appearance}}{{appearance}}{{else}}—{{/if}}</dd></div>
  </dl>

  <section class="coa-cert__section">
    <h4 class="coa-cert__heading">Quality test results</h4>
    <table class="coa-cert__table">
      <thead><tr>
        <th class="coa-cert__th--num">#</th><th>Parameter</th><th>Method</th>
        <th>Specification</th><th>Result</th><th class="coa-cert__th--status">Status</th>
      </tr></thead>
      <tbody>
        {{#each testResults}}
        <tr>
          <td class="coa-cert__td--num">{{pad2 @index}}</td>
          <td class="coa-cert__td--param">{{parameter}}</td>
          <td class="coa-cert__td--method">{{#if method}}{{method}}{{else}}—{{/if}}</td>
          <td class="coa-cert__td--spec">{{specification}}</td>
          <td class="coa-cert__td--result">{{result}}</td>
          <td class="coa-cert__td--status {{#if (eq status 'PASS')}}is-pass{{else if (eq status 'FAIL')}}is-fail{{/if}}">{{#if (eq status 'PASS')}}Pass{{else if (eq status 'FAIL')}}Fail{{else}}—{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  <section class="coa-cert__section coa-cert__section--conform">
    <h4 class="coa-cert__heading">Conformance statement</h4>
    <div class="coa-cert__conform {{#if (eq conclusion 'APPROVED')}}is-pass{{else}}is-fail{{/if}}">
      {{#if (eq conclusion 'APPROVED')}}Approved for release{{else}}Hold — failed parameters cannot be released{{/if}}
    </div>
    {{#if remarks}}<p class="coa-cert__statement">{{remarks}}</p>{{/if}}
  </section>

  <div class="coa-cert__spacer"></div>
  <div class="coa-cert__signoff"><div class="coa-cert__sign">Signature</div><div class="coa-cert__sign">Date</div></div>
  <footer class="coa-cert__footer">
    <span class="coa-cert__footer-code">{{productCode}}{{#if revision}} · {{revision}}{{/if}}</span>
    <span class="coa-cert__footer-center">CONFIDENTIAL — For authorised recipients only · {{company}}</span>
    <span class="coa-cert__footer-right">{{#if (eq documentStatus 'published')}}<strong>Original · </strong>{{/if}}Page 1 of 1</span>
  </footer>
</article>
