{{!--
  Mirrors safteyDataSheet/src/pages/Products/docPrint/TdsPrintDoc.jsx (the
  .ds-print markup) — same sections, order, copy and class names. The
  masthead is NOT here: Puppeteer renders it per page via
  buildPrintMatchedHeader() in pdf.service.ts, as it does the footer.
  numFeatures / numApplications / numSpecs / numPackaging / specRows /
  keyFacts / hasSpecs come from buildTdsContext() (pdf.service.ts).
--}}
<div class="document tds-print-doc ds-print">

  <div class="ds-print-identity">
    <div class="ds-print-identity__main">
      <span class="ds-print-identity__name">{{productName}}</span>
      {{#if subtitle}}<span class="ds-print-identity__sub">{{subtitle}}</span>{{/if}}
      {{#if description}}<p class="ds-print-identity__desc">{{description}}</p>{{/if}}
      {{#if keyFacts}}
      <dl class="ds-print-facts">
        {{#each keyFacts}}<div><dt>{{k}}</dt><dd>{{v}}</dd></div>{{/each}}
      </dl>
      {{/if}}
      <dl class="ds-print-docmeta">
        {{#if productCode}}<div><dt>Doc no</dt><dd>{{productCode}}</dd></div>{{/if}}
        {{#if revision}}<div><dt>Revision</dt><dd>{{revision}}</dd></div>{{/if}}
        {{#if issueDate}}<div><dt>Issued</dt><dd>{{issueDate}}</dd></div>{{/if}}
        {{#if revisionDate}}<div><dt>Revised</dt><dd>{{revisionDate}}</dd></div>{{/if}}
      </dl>
    </div>
  </div>

  {{#if numFeatures}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">{{numFeatures}}</span><span class="ds-print-section__title">Key features &amp; benefits</span></h2>
    <dl class="ds-print-rows">
      {{#each sections.features}}<div class="ds-print-row"><dt>{{head}}</dt><dd>{{body}}</dd></div>{{/each}}
    </dl>
  </section>
  {{/if}}

  {{#if numApplications}}
  <section class="ds-print-section ds-print-section--keep">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">{{numApplications}}</span><span class="ds-print-section__title">Typical applications</span></h2>
    <dl class="ds-print-rows">
      {{#each sections.performance}}<div class="ds-print-row"><dt>{{label}}</dt><dd>{{val}}</dd></div>{{/each}}
    </dl>
  </section>
  {{/if}}

  {{#if numSpecs}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">{{numSpecs}}</span><span class="ds-print-section__title">Typical technical specifications</span></h2>
    <table class="ds-print-table">
      <thead><tr><th>Property</th><th>Test method</th><th>Typical value</th></tr></thead>
      <tbody>
        {{#each specRows}}<tr><td>{{property}}</td><td>{{method}}</td><td>{{value}}</td></tr>{{/each}}
      </tbody>
    </table>
    {{#if sections.safetyNote}}
    <div class="ds-print-callout"><span class="ds-print-callout__title">Application note</span><p>{{sections.safetyNote}}</p></div>
    {{/if}}
  </section>
  {{/if}}

  {{#if numPackaging}}
  <section class="ds-print-section ds-print-section--keep">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">{{numPackaging}}</span><span class="ds-print-section__title">Packaging, storage &amp; safety</span></h2>
    <dl class="ds-print-rows">
      {{#each sections.packaging}}<div class="ds-print-row"><dt>{{type}}</dt><dd>Available in {{size}} {{unit}} containers.</dd></div>{{/each}}
    </dl>
  </section>
  {{/if}}

  {{#unless hasSpecs}}
  {{#if sections.safetyNote}}
  <div class="ds-print-callout"><span class="ds-print-callout__title">Application note</span><p>{{sections.safetyNote}}</p></div>
  {{/if}}
  {{/unless}}

</div>
