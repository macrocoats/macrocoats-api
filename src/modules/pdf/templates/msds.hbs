{{!--
  Mirrors safteyDataSheet/src/pages/Products/docPrint/MsdsPrintDoc.jsx
  (the .ds-print markup) — same sections, order, copy and class names. The
  masthead is NOT here: Puppeteer renders it per page via
  buildPrintMatchedHeader() in pdf.service.ts, as it does the footer.
  hStmts / pGroupList / isSimpleComposition / physicalRows / classifications /
  pictogramSummary / emergencyPhone / ppeBadges / effectiveSignalWord are
  precomputed in buildMsdsContext() (pdf.service.ts). Empty rows are skipped,
  matching PrintRows on the frontend.
--}}
<div class="document msds-print-doc ds-print">

  <div class="ds-print-identity">
    <div class="ds-print-identity__main">
      <span class="ds-print-identity__name">{{productName}}</span>
      {{#if sections.identification.productType}}<span class="ds-print-identity__sub">{{sections.identification.productType}}</span>{{/if}}
      <div class="ds-print-chips">
        <span class="ds-print-chip ds-print-chip--solid">Signal word: {{effectiveSignalWord}}</span>
        {{#if emergencyPhone}}<span class="ds-print-chip">Emergency {{emergencyPhone}}</span>{{/if}}
      </div>
      <dl class="ds-print-docmeta">
        {{#if productCode}}<div><dt>Ref</dt><dd>{{productCode}}</dd></div>{{/if}}
        {{#if revision}}<div><dt>Revision</dt><dd>{{revision}}</dd></div>{{/if}}
        {{#if issueDate}}<div><dt>Issued</dt><dd>{{issueDate}}</dd></div>{{/if}}
        {{#if revisionDate}}<div><dt>Revised</dt><dd>{{revisionDate}}</dd></div>{{/if}}
      </dl>
    </div>
    {{#if sections.hazards.pictograms}}
    <ul class="ds-print-pictos">
      {{#each sections.hazards.pictograms}}
      <li>
        <span class="ds-print-pictos__icon">{{ghsDiamond this}}</span>
        <span class="ds-print-pictos__label"><strong>{{ghsCode this}}</strong>{{ghsLabel this}}</span>
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </div>

  {{!-- 1 — IDENTIFICATION --}}
  <section class="ds-print-section ds-print-section--keep">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">1</span><span class="ds-print-section__title">Identification of the substance and company</span></h2>
    <dl class="ds-print-rows">
      <div class="ds-print-row"><dt>Product name</dt><dd>{{productName}}</dd></div>
      {{#if sections.identification.productType}}<div class="ds-print-row"><dt>Product type</dt><dd>{{sections.identification.productType}}</dd></div>{{/if}}
      {{#if sections.identification.intendedUse}}<div class="ds-print-row"><dt>Recommended use</dt><dd>{{sections.identification.intendedUse}}</dd></div>{{/if}}
      {{#if sections.identification.manufacturer}}<div class="ds-print-row"><dt>Manufacturer</dt><dd>{{sections.identification.manufacturer}}</dd></div>{{/if}}
      {{#if sections.identification.emergency}}<div class="ds-print-row"><dt>Emergency telephone</dt><dd>{{sections.identification.emergency}}</dd></div>{{/if}}
    </dl>
  </section>

  {{!-- 2 — HAZARD IDENTIFICATION --}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">2</span><span class="ds-print-section__title">Hazard identification</span></h2>
    <dl class="ds-print-rows">
      <div class="ds-print-row"><dt>Signal word</dt><dd>{{effectiveSignalWord}}</dd></div>
      {{#if pictogramSummary}}<div class="ds-print-row"><dt>Pictograms</dt><dd>{{pictogramSummary}}</dd></div>{{/if}}
      {{#each classifications}}<div class="ds-print-row"><dt>{{class}}</dt><dd>{{category}}</dd></div>{{/each}}
    </dl>
    {{#if hStmts}}
    <h3 class="ds-print-subhead">Hazard statements</h3>
    <dl class="ds-print-rows">
      {{#each hStmts}}<div class="ds-print-row is-code"><dt>{{code}}</dt><dd>{{text}}</dd></div>{{/each}}
    </dl>
    {{/if}}
    {{#each pGroupList}}
    <div>
      <h3 class="ds-print-subhead">{{label}}</h3>
      <dl class="ds-print-rows">
        {{#each items}}<div class="ds-print-row is-code"><dt>{{code}}</dt><dd>{{text}}</dd></div>{{/each}}
      </dl>
    </div>
    {{/each}}
  </section>

  {{!-- 3 — COMPOSITION --}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">3</span><span class="ds-print-section__title">Composition / information on ingredients</span></h2>
    <table class="ds-print-table">
      <thead>
        <tr>
          {{#unless isSimpleComposition}}<th>Component</th>{{/unless}}
          <th>Function</th>
          <th>Classification</th>
        </tr>
      </thead>
      <tbody>
        {{#each sections.composition.ingredients}}
        <tr>
          {{#unless ../isSimpleComposition}}<td>{{#if name}}{{name}}{{else}}—{{/if}}</td>{{/unless}}
          <td>{{description}}</td>
          <td>{{ghsClass}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#if sections.composition.note}}<p class="ds-print-note">{{sections.composition.note}}</p>{{/if}}
  </section>

  {{!-- 4 — FIRST AID --}}
  <section class="ds-print-section ds-print-section--keep">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">4</span><span class="ds-print-section__title">First-aid measures</span></h2>
    <dl class="ds-print-rows">
      {{#if sections.firstAid.eyes}}<div class="ds-print-row"><dt>Eye contact</dt><dd>{{sections.firstAid.eyes}}</dd></div>{{/if}}
      {{#if sections.firstAid.skin}}<div class="ds-print-row"><dt>Skin contact</dt><dd>{{sections.firstAid.skin}}</dd></div>{{/if}}
      {{#if sections.firstAid.inhalation}}<div class="ds-print-row"><dt>Inhalation</dt><dd>{{sections.firstAid.inhalation}}</dd></div>{{/if}}
      {{#if sections.firstAid.ingestion}}<div class="ds-print-row"><dt>Ingestion</dt><dd>{{sections.firstAid.ingestion}}</dd></div>{{/if}}
    </dl>
    {{#if sections.firstAid.warning}}
    <div class="ds-print-callout"><span class="ds-print-callout__title">Note to physician</span><p>{{sections.firstAid.warning}}</p></div>
    {{/if}}
  </section>

  {{!-- 5 — FIRE-FIGHTING --}}
  <section class="ds-print-section ds-print-section--keep">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">5</span><span class="ds-print-section__title">Fire-fighting measures</span></h2>
    <dl class="ds-print-rows">
      {{#if sections.fireFighting.flammability}}<div class="ds-print-row"><dt>Flammability</dt><dd>{{sections.fireFighting.flammability}}</dd></div>{{/if}}
      {{#if sections.fireFighting.extinguishingMedia}}<div class="ds-print-row"><dt>Extinguishing media</dt><dd>{{sections.fireFighting.extinguishingMedia}}</dd></div>{{/if}}
      {{#if sections.fireFighting.fireHazard}}<div class="ds-print-row"><dt>Fire hazard</dt><dd>{{sections.fireFighting.fireHazard}}</dd></div>{{/if}}
      {{#if sections.fireFighting.ppe}}<div class="ds-print-row"><dt>Firefighter PPE</dt><dd>{{sections.fireFighting.ppe}}</dd></div>{{/if}}
    </dl>
  </section>

  {{!-- 6 — ACCIDENTAL RELEASE --}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">6</span><span class="ds-print-section__title">Accidental release measures</span></h2>
    <ol class="ds-print-list">
      {{#each sections.accidentalRelease}}<li><span class="ds-print-list__n">{{inc @index}}</span><span>{{this}}</span></li>{{/each}}
    </ol>
  </section>

  {{!-- 7 — HANDLING & STORAGE --}}
  <section class="ds-print-section ds-print-section--keep">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">7</span><span class="ds-print-section__title">Handling and storage</span></h2>
    <dl class="ds-print-rows">
      {{#if sections.handling.handling}}<div class="ds-print-row"><dt>Handling</dt><dd>{{sections.handling.handling}}</dd></div>{{/if}}
      {{#if sections.handling.storageTemp}}<div class="ds-print-row"><dt>Storage temperature</dt><dd>{{sections.handling.storageTemp}}</dd></div>{{/if}}
      {{#if sections.handling.shelfLife}}<div class="ds-print-row"><dt>Shelf life</dt><dd>{{sections.handling.shelfLife}}</dd></div>{{/if}}
      {{#if sections.handling.containers}}<div class="ds-print-row"><dt>Containers</dt><dd>{{sections.handling.containers}}</dd></div>{{/if}}
      {{#if sections.handling.segregation}}<div class="ds-print-row"><dt>Segregation</dt><dd>{{sections.handling.segregation}}</dd></div>{{/if}}
    </dl>
  </section>

  {{!-- 8 — EXPOSURE CONTROLS --}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">8</span><span class="ds-print-section__title">Exposure controls / personal protection</span></h2>
    {{#if sections.exposure.engineering}}
    <dl class="ds-print-rows">
      <div class="ds-print-row"><dt>Engineering controls</dt><dd>{{sections.exposure.engineering}}</dd></div>
    </dl>
    {{/if}}
    {{#if ppeBadges}}
    <ul class="ds-print-ppe">
      {{#each ppeBadges}}<li><span class="ds-print-ppe__badge">{{code}}</span><span>{{label}}</span></li>{{/each}}
    </ul>
    {{/if}}
  </section>

  {{!-- 9 — PHYSICAL PROPERTIES --}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">9</span><span class="ds-print-section__title">Physical and chemical properties</span></h2>
    <dl class="ds-print-rows">
      {{#each physicalRows}}<div class="ds-print-row"><dt>{{key}}</dt><dd>{{val}}</dd></div>{{/each}}
    </dl>
  </section>

  {{!-- 10 — STABILITY --}}
  <section class="ds-print-section ds-print-section--keep">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">10</span><span class="ds-print-section__title">Stability and reactivity</span></h2>
    <dl class="ds-print-rows">
      {{#if sections.stability.stability}}<div class="ds-print-row"><dt>Stability</dt><dd>{{sections.stability.stability}}</dd></div>{{/if}}
      {{#if sections.stability.avoid}}<div class="ds-print-row"><dt>Conditions to avoid</dt><dd>{{sections.stability.avoid}}</dd></div>{{/if}}
      {{#if sections.stability.polymerisation}}<div class="ds-print-row"><dt>Hazardous polymerisation</dt><dd>{{sections.stability.polymerisation}}</dd></div>{{/if}}
      {{#if sections.stability.decomposition}}<div class="ds-print-row"><dt>Hazardous decomposition</dt><dd>{{sections.stability.decomposition}}</dd></div>{{/if}}
    </dl>
  </section>

  {{!-- 11–16 --}}
  {{#each sections11to16Entries}}
  <section class="ds-print-section">
    <h2 class="ds-print-section__bar"><span class="ds-print-section__num">{{number}}</span><span class="ds-print-section__title">{{key}}</span></h2>
    <p class="ds-print-para">{{value}}</p>
  </section>
  {{/each}}

</div>
